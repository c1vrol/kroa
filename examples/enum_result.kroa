enum Result:
    Ok(value: i64)
    Err(code: i64)

fn main() -> i64:
    let r = Result::Ok(42)
    match r:
        case Result::Ok(v):
            print_i64(v)
        case Result::Err(c):
            print_i64(c)
    let e = Result::Err(7)
    match e:
        case Result::Ok(v):
            print_i64(v)
        case Result::Err(c):
            print_i64(c)
    return 0
